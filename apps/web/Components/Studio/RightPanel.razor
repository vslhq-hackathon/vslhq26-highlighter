@inherits StudioComponent
@inject Highlighter.Web.Services.StudioAgentService Agent

<div class="anim-fade-up flex min-h-0 w-[288px] shrink-0 flex-col border-l border-line bg-panel" style="animation-delay:120ms">
    @if (AgentAvailable)
    {
        <div class="flex gap-0.5 border-b border-line px-2.5 py-2">
            @foreach (var (key, label) in new[] { ("inspector", "Inspector"), ("agent", "Agent") })
            {
                <div @onclick="() => OpenPanel(key)" class="flex-1 cursor-pointer rounded py-[5px] text-center text-xs font-semibold hover:text-fg @(S.Panel == key ? "bg-well text-fg" : "bg-transparent text-muted")">@label</div>
            }
        </div>
    }
    else
    {
        @* Highlight editors are agent-free: one full-width Inspector header. *@
        <div class="border-b border-line px-2.5 py-2">
            <div class="rounded bg-well py-[5px] text-center text-xs font-semibold text-fg">Inspector</div>
        </div>
    }

    @if (S.Panel == "inspector" || !AgentAvailable)
    {
        <div class="anim-fade-up flex flex-1 flex-col overflow-y-auto px-4 py-3.5">
            <div class="pb-2.5 font-mono text-[9.5px] tracking-[0.1em] text-faint">
                CUT · @(S.ActiveClip is null ? $"LONG-FORM V{S.Edit.Meta?.LongformVersion ?? 1}" : "HIGHLIGHT")
                · <span class="@(S.Edit.SaveState == "Save failed" ? "text-playhead" : "text-faint")">@S.Edit.SaveState.ToUpperInvariant()</span>
            </div>

            <div class="pb-1.5 font-mono text-[9.5px] tracking-[0.1em] text-faint">SELECTION</div>
            @* Every selectable block on the timeline gets its editor here —
               clicking a caption or a marker used to land on the "select
               something" hint, which is what nothing-happens looks like. *@
            @if (S.Edit.SelectedSegment is { } segment)
            {
                <Slider Label="Segment speed" Value="@segment.Speed" Min="0.5" Max="2" Step="0.05"
                        Display="@($"{segment.Speed:0.##}×")"
                        OnChange="v => S.Edit.SetSegmentSpeed(segment.Id, v)" />
            }
            else if (S.Edit.SelectedCaption is { } caption)
            {
                <div class="pb-4">
                    <div class="mb-[7px] flex items-center justify-between text-xs">
                        <span class="font-semibold text-soft">Caption</span>
                        <span class="font-mono text-[9.5px] text-faint">@Fmt.Stamp(caption.Start)</span>
                    </div>
                    <input value="@caption.Text" @onchange='e => S.Edit.UpdateCaptionText(caption.Id, e.Value?.ToString() ?? "")'
                           class="box-border w-full rounded-md border border-line3 bg-ink px-[10px] py-[7px] font-sans text-[12px] text-fg outline-none focus:border-[#4A4638]" />
                </div>
            }
            else if (S.Edit.SelectedText is { } text)
            {
                <div class="pb-4">
                    <div class="mb-[7px] text-xs font-semibold text-soft">Text overlay</div>
                    <input value="@text.Text" @onchange='e => S.Edit.UpdateTextOverlay(text.Id, text: e.Value?.ToString() ?? "")'
                           class="box-border w-full rounded-md border border-line3 bg-ink px-[10px] py-[7px] font-sans text-[12px] text-fg outline-none focus:border-[#4A4638]" />
                </div>
                <Slider Label="Text position" Value="@text.Y" Min="0.05" Max="0.9" Step="0.01"
                        Display="@($"{text.Y * 100:0}%")"
                        OnChange="v => S.Edit.UpdateTextOverlay(text.Id, y: v)" />
            }
            else if (S.Edit.SelectedMarker is { } marker)
            {
                <div class="pb-4">
                    <div class="mb-[7px] flex items-center justify-between text-xs">
                        <span class="font-semibold text-soft">Marker</span>
                        <span class="font-mono text-[9.5px] text-faint">@Fmt.Stamp(marker.At)</span>
                    </div>
                    <input value="@marker.Label" @onchange='e => S.Edit.UpdateMarkerLabel(marker.Id, e.Value?.ToString() ?? "")'
                           class="box-border w-full rounded-md border border-line3 bg-ink px-[10px] py-[7px] font-sans text-[12px] text-fg outline-none focus:border-[#4A4638]" />
                </div>
            }
            else
            {
                <div class="pb-4 text-[10.5px] leading-[1.5] text-faint">Select a segment, caption, text or marker on the timeline.</div>
            }

            @if (S.ActiveClip is not null)
            {
                <div class="mb-3.5 border-t border-line pt-3">
                    <div class="mb-[7px] flex items-center justify-between text-xs">
                        <span class="font-semibold text-soft">Extend clip</span>
                        @if (S.Edit.Meta?.Handles is not null)
                        {
                            <span class="font-mono text-[9.5px] text-faint">handle material</span>
                        }
                    </div>
                    @if (S.Edit.Meta?.Handles is not null)
                    {
                        <div class="flex flex-col gap-1.5">
                            <div class="flex items-center justify-between text-[11.5px]">
                                <span class="text-muted">Start <span class="font-mono text-[10px] text-faint">(@($"{S.Edit.AvailableLead:0.0}s") left)</span></span>
                                <span class="flex overflow-hidden rounded border border-line2">
                                    <span @onclick="() => S.Edit.ExtendStart(1)" class="px-2 py-[3px] @(S.Edit.AvailableLead > 0.05 ? "cursor-pointer text-soft hover:bg-well hover:text-fg" : "pointer-events-none text-ghost")">−1s</span>
                                    <span @onclick="() => S.Edit.ExtendStart(5)" class="border-l border-line2 px-2 py-[3px] @(S.Edit.AvailableLead > 0.05 ? "cursor-pointer text-soft hover:bg-well hover:text-fg" : "pointer-events-none text-ghost")">−5s</span>
                                </span>
                            </div>
                            <div class="flex items-center justify-between text-[11.5px]">
                                <span class="text-muted">End <span class="font-mono text-[10px] text-faint">(@($"{S.Edit.AvailableTail:0.0}s") left)</span></span>
                                <span class="flex overflow-hidden rounded border border-line2">
                                    <span @onclick="() => S.Edit.ExtendEnd(1)" class="px-2 py-[3px] @(S.Edit.AvailableTail > 0.05 ? "cursor-pointer text-soft hover:bg-well hover:text-fg" : "pointer-events-none text-ghost")">+1s</span>
                                    <span @onclick="() => S.Edit.ExtendEnd(5)" class="border-l border-line2 px-2 py-[3px] @(S.Edit.AvailableTail > 0.05 ? "cursor-pointer text-soft hover:bg-well hover:text-fg" : "pointer-events-none text-ghost")">+5s</span>
                                </span>
                            </div>
                            <div class="text-[10px] leading-[1.5] text-faint">Pulls footage the pipeline kept around the cut — fix an early or late cut point, then trim as usual.</div>
                        </div>
                    }
                    else
                    {
                        <div class="text-[10.5px] leading-[1.5] text-faint">Extension needs handle material around the cut — available for clips rendered after this update.</div>
                    }
                </div>
            }

            @if (S.Edit.Doc is { } doc)
            {
                <div class="mt-2 border-t border-line pt-3.5">
                    <div class="pb-2.5 font-mono text-[9.5px] tracking-[0.1em] text-faint">FRAME</div>
                    <div class="mb-3.5 flex flex-col gap-3">
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-semibold text-soft">Format</span>
                            @if (S.ActiveClip is null)
                            {
                                @* The long-form cut is the 16:9 deliverable. *@
                                <span class="font-mono text-[10.5px] text-faint">16:9 · source</span>
                            }
                            else
                            {
                                <span class="flex overflow-hidden rounded border border-line2">
                                    @foreach (var (key, label) in FormatOptions)
                                    {
                                        <span @onclick="() => S.Edit.SetFormat(key)" title="@label"
                                              class="cursor-pointer px-[8px] py-[3px] @(key != FormatOptions[0].Key ? "border-l border-line2" : "") @(CurrentFormat == key ? "bg-well font-semibold text-fg" : "text-muted hover:text-fg")">@label</span>
                                    }
                                </span>
                            }
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-semibold text-soft">Reframe</span>
                            <span class="flex overflow-hidden rounded border border-line2">
                                <span @onclick='() => S.Edit.SetReframe("auto")' title="Auto"
                                      class="cursor-pointer px-[9px] py-[3px] @(doc.Reframe != "manual" ? "bg-well font-semibold text-fg" : "text-muted hover:text-fg")">Auto</span>
                                <span @onclick='() => S.Edit.SetReframe("manual")' title="Manual"
                                      class="cursor-pointer border-l border-line2 px-[9px] py-[3px] @(doc.Reframe == "manual" ? "bg-well font-semibold text-fg" : "text-muted hover:text-fg")">Manual</span>
                            </span>
                        </div>
                    </div>
                    <Slider Label="Zoom" Value="@doc.Transform.Scale" Min="1" Max="3" Step="0.05"
                            Display="@($"{doc.Transform.Scale:0.##}×")"
                            OnChange="v => S.Edit.SetTransform(scale: v)" />
                    <Slider Label="Position X" Value="@doc.Transform.PosX" Min="-1" Max="1" Step="0.05"
                            Display="@($"{doc.Transform.PosX:+0.##;-0.##;0}")"
                            OnChange="v => S.Edit.SetTransform(posX: v)" />
                    <div class="pb-1 text-[10px] leading-[1.5] text-faint">@FrameHint</div>
                </div>

                <div class="mt-2 border-t border-line pt-3.5">
                    <div class="pb-2.5 font-mono text-[9.5px] tracking-[0.1em] text-faint">AUDIO</div>
                    <Slider Label="Voice volume" Value="@doc.Audio.Voice" Min="0" Max="2" Step="0.05"
                            Display="@($"{doc.Audio.Voice * 100:0}%")"
                            OnChange="v => S.Edit.SetAudio(voice: v)" />
                    @if (doc.Audio.Voice > 1.001)
                    {
                        <div class="-mt-1 pb-3 text-[10px] leading-[1.5] text-faint">Boost above 100% applies on export; the preview plays at 100%.</div>
                    }
                    <Slider Label="Music bed" Value="@doc.Audio.Music" Min="0" Max="1" Step="0.05"
                            Display="@(doc.Audio.Music > 0.001 ? $"{doc.Audio.Music * 100:0}%" : "off")"
                            OnChange="v => S.Edit.SetAudio(music: v)" />
                </div>

                <div class="mt-2 flex flex-col gap-3 border-t border-line pt-3.5">
                    <div class="font-mono text-[9.5px] tracking-[0.1em] text-faint">CAPTIONS</div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-semibold @(HasCaptions ? "text-soft" : "text-faint")">Burn in</span>
                        @if (HasCaptions)
                        {
                            <span @onclick="() => S.Edit.SetCaptionsEnabled(!CaptionsOn)" title="Burn in"
                                  class="relative h-[17px] w-[30px] cursor-pointer rounded-[9px] @(CaptionsOn ? "bg-accent" : "bg-well")">
                                <span class="absolute top-0.5 h-[13px] w-[13px] rounded-full @(CaptionsOn ? "right-0.5 bg-ink" : "left-0.5 bg-muted")"></span>
                            </span>
                        }
                        else
                        {
                            <span class="relative h-[17px] w-[30px] rounded-[9px] bg-well opacity-40">
                                <span class="absolute left-0.5 top-0.5 h-[13px] w-[13px] rounded-full bg-muted"></span>
                            </span>
                        }
                    </div>
                    @if (!HasCaptions)
                    {
                        <div class="-mt-1 text-[10.5px] leading-[1.5] text-faint">No caption lines on this cut — the transcript had no words in its window.</div>
                    }
                    else
                    {
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-semibold text-soft">Style</span>
                            <span class="flex overflow-hidden rounded border border-line2">
                                @foreach (var (key, label) in CaptionStyleOptions)
                                {
                                    <span @onclick="() => PickStyle(key)" title="@label"
                                          class="cursor-pointer px-[8px] py-[3px] @(key != CaptionStyleOptions[0].Key ? "border-l border-line2" : "") @(doc.CaptionStyle == key ? "bg-well font-semibold text-fg" : "text-muted hover:text-fg")">@label</span>
                                }
                            </span>
                        </div>
                    }
                </div>
                @* Snap lives on the timeline toolbar, where it applies — a
                   second copy here was the same switch twice. *@
            }
        </div>
    }

    @if (S.Panel == "agent" && AgentAvailable)
    {
        <div class="flex flex-1 flex-col gap-2.5 overflow-y-auto p-3">
            @foreach (var message in S.AgentMessages)
            {
                @if (message.Role == "user")
                {
                    <div class="anim-fade-up max-w-[88%] self-end rounded-[7px] bg-well px-3 py-[9px] text-xs leading-[1.55] text-fg">@message.Text</div>
                }
                else
                {
                    <div class="anim-fade-up rounded-[7px] border border-well bg-card2 px-[13px] py-[11px]">
                        <div class="mb-1.5 font-mono text-[9.5px] tracking-[0.1em] text-accent">AGENT</div>
                        <div class="text-xs leading-[1.6] text-soft">@message.Text</div>
                    </div>
                }
            }
            @if (S.AgentBusy)
            {
                <div class="anim-fade-up flex items-center gap-2 rounded-[7px] border border-well bg-card2 px-[13px] py-[11px]">
                    <span class="h-1.5 w-1.5 animate-pulse-dc rounded-full bg-accent"></span>
                    <span class="text-xs text-muted">working…</span>
                </div>
            }
        </div>
        <div class="anim-fade-up border-t border-line p-2.5">
            <div class="flex items-center gap-2 rounded-[7px] border border-line2 bg-card2 p-[3px] pl-[11px]">
                <input @bind="S.AgentInput" @bind:event="oninput" @onkeydown="OnAgentKey" placeholder="Ask for a change…" class="flex-1 border-none bg-transparent py-[7px] font-sans text-xs text-fg outline-none" />
                <span @onclick="SendToAgent" class="cursor-pointer rounded bg-accent px-[9px] py-[5px] text-[11px] font-bold text-ink hover:bg-accent-soft active:scale-90">↑</span>
            </div>
        </div>
    }
</div>

@code {
    bool AgentAvailable => S.ActiveClip is null; // long-form editor only

    static readonly (string Key, string Label)[] FormatOptions =
        [("vertical", "9:16"), ("square", "1:1"), ("wide", "16:9")];

    static readonly (string Key, string Label)[] CaptionStyleOptions =
        [("boxed", "Boxed"), ("plain", "Plain"), ("karaoke", "Karaoke")];

    string CurrentFormat => S.Edit.Doc?.Format ?? "source";
    bool HasCaptions => S.Edit.Doc is { Captions.Count: > 0 };
    bool CaptionsOn => S.Edit.Doc?.CaptionsEnabled ?? true;

    /// <summary>At the source aspect there is no crop window to slide until
    /// zoom opens one — say so instead of letting Position X look broken.</summary>
    string FrameHint => S.Edit.Doc switch
    {
        { Reframe: "manual", Format: "source" or null } d when d.Transform.Scale <= 1.001 =>
            "Position needs zoom above 1× at the source aspect.",
        { Reframe: "manual" } => "Manual crops into the frame — zoom and position pick the window.",
        _ => "Auto fits the whole frame and blurs the margins. Dragging zoom or position switches to manual.",
    };

    void PickStyle(string style)
    {
        S.SetCapStyle(style);            // preview fallback outside the editor
        S.Edit.SetCaptionStyle(style);
    }

    async Task OpenPanel(string key)
    {
        S.SetPanel(key);
        if (key == "agent") await Agent.SeedContextAsync();
    }

    async Task SendToAgent()
    {
        if (S.AgentBusy || string.IsNullOrWhiteSpace(S.AgentInput)) return;
        var text = S.AgentInput;
        S.AgentInput = "";
        S.Notify();
        await Agent.SendAsync(text);
    }

    async Task OnAgentKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendToAgent();
    }
}
