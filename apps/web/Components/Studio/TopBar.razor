@inherits StudioComponent
@inject AuthSession Auth
@inject NavigationManager Nav

<div class="flex h-[54px] shrink-0 items-center gap-5 border-b border-line bg-bar px-6">
    <div @onclick="S.GoProjects" class="cursor-pointer text-[15px] font-extrabold leading-none tracking-[0.05em]">
        <span class="rounded-[3px] bg-accent pb-[2px] pl-[5px] pr-[5px] pt-[3px] text-ink">HIGH</span><span class="pb-[2px] pl-[3px] pt-[3px]">LIGHTER</span>
    </div>
    <div class="flex items-center gap-1.5 text-[13px] text-muted">
        <span @onclick="S.GoProjects" class="cursor-pointer hover:text-fg @(S.IsProjects ? "text-fg" : "text-muted")">Projects</span>
        @if (S.IsProject)
        {
            <span class="anim-fade-left text-faint">/</span>
            <span class="anim-fade-left font-semibold text-fg" style="animation-delay:40ms">@S.ProjectTitle</span>
        }
    </div>
    <div class="ml-auto flex items-center gap-[14px]">
        <div class="relative">
            <div class="flex w-[260px] items-center gap-2 rounded-md border border-line2 bg-ink px-[11px]">
                <span class="text-xs text-faint">⌕</span>
                <input @bind="S.Search" @bind:event="oninput" @bind:after="S.QueueSearch"
                       placeholder="@(S.IsProject ? "Search this project…" : "Search projects, highlights…")" class="flex-1 border-none bg-transparent py-[7px] font-sans text-[12.5px] text-fg outline-none" />
                @if (S.Search.Trim().Length > 0)
                {
                    <span @onclick="ClearSearch" class="cursor-pointer text-[11px] text-faint hover:text-fg">✕</span>
                }
            </div>
            @if (S.Search.Trim().Length >= 2 && S.SearchHits.Count > 0)
            {
                <div class="anim-drop-in absolute left-0 right-0 top-[calc(100%_+_6px)] z-50 max-h-[340px] overflow-y-auto rounded-md border border-line3 bg-elevate p-1 shadow-[0_12px_32px_rgba(0,0,0,0.45)]">
                    @foreach (var hit in S.SearchHits)
                    {
                        <div @onclick="() => S.OpenHit(hit)" class="flex cursor-pointer items-center gap-2 rounded px-2.5 py-[7px] hover:bg-well">
                            <span class="shrink-0 rounded-[3px] border border-line2 px-[5px] py-px font-mono text-[9px] uppercase @KindColor(hit.Kind)">@KindLabel(hit.Kind)</span>
                            <span class="min-w-0 flex-1 break-words text-[12px] text-soft">@Fmt.Title(hit.Title)</span>
                            @if (hit.Kind != "project")
                            {
                                <span class="max-w-[80px] shrink-0 truncate text-[10px] text-faint">@hit.ProjectName</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div class="relative">
            <div @onclick="() => _menuOpen = !_menuOpen"
                 class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-full bg-[#2C2A27] text-[11px] font-bold text-soft hover:bg-[#38352F]">
                @Auth.Initials
            </div>
            @if (_menuOpen)
            {
                <div class="anim-drop-in absolute right-0 top-[calc(100%_+_8px)] z-50 w-[200px] rounded-md border border-line3 bg-elevate p-1 shadow-[0_12px_32px_rgba(0,0,0,0.45)]">
                    <div class="truncate border-b border-line px-2.5 py-2 text-[11.5px] text-muted">@Auth.Email</div>
                    <div @onclick="SignOutAsync"
                         class="cursor-pointer rounded px-2.5 py-[7px] text-[12.5px] text-soft hover:bg-well hover:text-fg">
                        Sign out
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool _menuOpen;

    private void ClearSearch()
    {
        S.Search = "";
        S.QueueSearch();
    }

    private static string KindLabel(string kind) => kind switch
    {
        "cut" => "CUT",
        "highlight" => "CLIP",
        _ => "PROJ",
    };

    private static string KindColor(string kind) => kind switch
    {
        "cut" => "text-accent",
        "highlight" => "text-[#9FB6CE]",
        _ => "text-muted",
    };

    private async Task SignOutAsync()
    {
        _menuOpen = false;
        try
        {
            await Auth.SignOutAsync();
        }
        catch (Exception)
        {
            // A failed remote logout still signs out locally below.
        }
        Nav.NavigateTo("/login");
    }
}
