@inherits StudioComponent

@* The real timeline: an output-time view of the EDL (cuts collapsed). Tools:
   select, razor (split at click), trim (drag block edges), slip (drag inside a
   block), text and marker (click adds one at that time). Snap = ¼-second grid.
   Delete removes the selection. All edits are undoable and autosaved. *@

@* Keyboard lives on EditorOverlay's document-level listener — a second
   handler here would double-fire every shortcut. *@
<div class="anim-fade-up flex h-[272px] shrink-0 flex-col border-t border-line bg-ink outline-none" style="animation-delay:150ms"
     @onpointermove="OnPointerMove" @onpointerup="OnPointerUp" @onpointerleave="OnPointerUp">
    @* toolbar *@
    <div class="flex items-center gap-0.5 border-b border-line bg-panel px-2.5 py-[5px]">
        @foreach (var (key, icon, label) in ToolDefs)
        {
            <div @onclick="() => S.SetTool(key)" title="@label" class="flex h-[26px] w-[30px] cursor-pointer items-center justify-center rounded text-xs @(S.Tool == key ? "bg-accent text-ink" : "bg-transparent text-muted hover:text-fg")">@icon</div>
        }
        <div class="mx-[7px] h-[15px] w-px bg-line2"></div>
        <div @onclick="S.ToggleSnap" class="flex cursor-pointer items-center gap-1.5 rounded px-[9px] py-1 text-[11.5px] font-semibold hover:text-fg @(S.Snap ? "text-accent" : "text-muted")"><span class="font-mono text-[10px]">⌗</span>Snap</div>
        <div title="Cuts always ripple in this editor — removed time collapses" class="flex items-center gap-1.5 px-[9px] py-1 text-[11.5px] font-semibold text-accent"><span class="font-mono text-[10px]">±</span>Ripple</div>
        @if (E.SelectedId is not null)
        {
            <div @onclick="E.DeleteSelected" class="flex cursor-pointer items-center gap-1.5 rounded px-[9px] py-1 text-[11.5px] font-semibold text-muted hover:text-playhead">✕ Delete</div>
        }
        <div class="ml-auto flex items-center gap-2.5">
            <span @onclick="() => E.Zoom(1 / 1.4)" class="cursor-pointer px-1 font-mono text-[11px] text-faint hover:text-fg">−</span>
            <span class="font-mono text-[10px] text-faint">@($"{E.PxPerSec:0.#}px/s")</span>
            <span @onclick="() => E.Zoom(1.4)" class="cursor-pointer px-1 font-mono text-[11px] text-faint hover:text-fg">+</span>
            <span @onclick="E.FitZoom" class="cursor-pointer rounded-[3px] border border-line2 px-[7px] py-0.5 font-mono text-[10px] text-faint hover:text-fg">FIT</span>
        </div>
    </div>

    @if (E.Doc is null)
    {
        <div class="flex flex-1 items-center justify-center gap-2 font-mono text-[11px] text-dim">
            @if (E.Loading)
            {
                <span class="h-1.5 w-1.5 animate-pulse-dc rounded-full bg-accent"></span>
                <span>loading timeline…</span>
            }
            else
            {
                <span>@(E.Error ?? "no editable media")</span>
            }
        </div>
    }
    else
    {
        <div class="relative flex min-h-0 flex-1 flex-col">
            <div class="min-h-0 flex-1 overflow-x-auto overflow-y-auto" @ref="_scroller">
                <div class="relative" style="width:@($"{TotalWidth + 118 + 40}px")">
                    @* ruler *@
                    <div class="sticky top-0 z-[6] flex border-b border-[#1E1C1A] bg-ink">
                        <div class="sticky left-0 z-[7] w-[118px] shrink-0 border-r border-[#1E1C1A] bg-ink"></div>
                        <div class="relative h-[20px]" style="width:@($"{TotalWidth}px")"
                             @onclick="OnRulerClick">
                            @foreach (var mark in RulerMarks())
                            {
                                @* pointer-events-none: clicks must hit the ruler itself so OffsetX is ruler-relative *@
                                <div class="pointer-events-none absolute bottom-0 top-0 border-l border-well pl-[5px] pt-1 font-mono text-[9px] text-faint" style="left:@($"{mark.X:0.##}px")">@mark.Label</div>
                            }
                        </div>
                    </div>

                    @* T1 captions + texts *@
                    <div class="flex items-stretch border-b border-[#1A1918]" style="height:44px">
                        <div class="sticky left-0 z-[6] flex w-[118px] shrink-0 items-center gap-[7px] border-r border-[#1E1C1A] bg-panel px-[9px]">
                            <span class="w-5 font-mono text-[10px] font-medium text-soft">T1</span>
                            <span class="ml-auto font-mono text-[8.5px] text-ghost">TEXT</span>
                        </div>
                        <div class="relative" style="width:@($"{TotalWidth}px")" @onclick="OnLaneClick">
                            @foreach (var (caption, window) in VisibleCaptions())
                            {
                                <div @onclick="() => OnBlockClick(caption.Id)" @onclick:stopPropagation
                                     @onpointerdown='e => OnBlockPointerDown(e, caption.Id, "window")'
                                     class="absolute bottom-[3px] top-[3px] cursor-pointer overflow-hidden rounded-[3px] border px-1.5 pt-0.5 text-[9.5px] font-semibold @(E.SelectedId == caption.Id ? "border-accent bg-[#2A2B1E] text-fg" : "border-[#3E3B2A] bg-[#23241A] text-soft")"
                                     style="left:@Px(window.Start); width:@Px(window.End - window.Start)">
                                    <span class="whitespace-nowrap">@caption.Text</span>
                                </div>
                            }
                            @foreach (var (text, window) in VisibleTexts())
                            {
                                <div @onclick="() => OnBlockClick(text.Id)" @onclick:stopPropagation
                                     @onpointerdown='e => OnBlockPointerDown(e, text.Id, "window")'
                                     class="absolute bottom-[3px] top-[3px] cursor-pointer overflow-hidden rounded-[3px] border px-1.5 pt-0.5 text-[9.5px] font-bold @(E.SelectedId == text.Id ? "border-accent bg-[#32301E]" : "border-[#4A4638] bg-[#2A2820]") text-fg"
                                     style="left:@Px(window.Start); width:@Px(Math.Max(0.4, window.End - window.Start))">
                                    <span class="whitespace-nowrap">T · @text.Text</span>
                                </div>
                            }
                            @foreach (var marker in E.Doc.Markers)
                            {
                                var at = E.SourceToOutput(marker.At);
                                if (at is null) { continue; }
                                <div @onclick="() => OnBlockClick(marker.Id)" @onclick:stopPropagation
                                     title="@marker.Label"
                                     class="absolute top-0 h-full w-[7px] -translate-x-[3px] cursor-pointer"
                                     style="left:@Px(at.Value)">
                                    <div class="mx-auto h-full w-[2px] @(E.SelectedId == marker.Id ? "bg-accent" : "bg-[#8A6FCB]")"></div>
                                </div>
                            }
                        </div>
                    </div>

                    @* V1 video segments *@
                    <div class="flex items-stretch border-b border-[#1A1918]" style="height:56px">
                        <div class="sticky left-0 z-[6] flex w-[118px] shrink-0 items-center gap-[7px] border-r border-[#1E1C1A] bg-panel px-[9px]">
                            <span class="w-5 font-mono text-[10px] font-medium text-soft">V1</span>
                            <span class="ml-auto font-mono text-[8.5px] text-ghost">VIDEO</span>
                        </div>
                        <div class="relative" style="width:@($"{TotalWidth}px")" @onclick="OnLaneClick">
                            @foreach (var (segment, outStart, outEnd) in E.SegmentLayout())
                            {
                                <div @onclick="e => OnSegmentClick(e, segment, outStart)" @onclick:stopPropagation
                                     @onpointerdown="e => OnSegmentPointerDown(e, segment)"
                                     class="absolute bottom-[3px] top-[3px] overflow-hidden rounded-[3px] border @SegmentCursor @(E.SelectedId == segment.Id ? "border-accent bg-[#25313F]" : "border-[#3E5871] bg-[#22303F]")"
                                     style="left:@Px(outStart); width:@Px(outEnd - outStart)">
                                    <div class="pointer-events-none absolute left-1.5 top-0.5 whitespace-nowrap text-[9.5px] font-semibold text-[#9FB6CE]">
                                        @Fmt.Stamp(segment.SrcStart)–@Fmt.Stamp(segment.SrcEnd)
                                        @if (Math.Abs(segment.Speed - 1) > 0.01)
                                        {
                                            <span class="text-accent"> · @($"{segment.Speed:0.##}×")</span>
                                        }
                                    </div>
                                    @* trim handles *@
                                    <div @onpointerdown='e => OnBlockPointerDown(e, segment.Id, "trim-left")' @onpointerdown:stopPropagation
                                         class="absolute bottom-0 left-0 top-0 w-[6px] cursor-ew-resize bg-[rgba(217,242,75,0.0)] hover:bg-[rgba(217,242,75,0.35)]"></div>
                                    <div @onpointerdown='e => OnBlockPointerDown(e, segment.Id, "trim-right")' @onpointerdown:stopPropagation
                                         class="absolute bottom-0 right-0 top-0 w-[6px] cursor-ew-resize bg-[rgba(217,242,75,0.0)] hover:bg-[rgba(217,242,75,0.35)]"></div>
                                </div>
                            }
                            @* Handle-material end caps: media beyond the edit
                               (the professional-NLE cue that outward trims work) *@
                            @if (E.Meta?.Handles is not null && E.AvailableLead > 0.05)
                            {
                                <span class="pointer-events-none absolute left-0.5 top-1/2 z-[5] -translate-y-1/2 rounded-[3px] bg-[rgba(20,19,18,0.85)] px-1 py-0.5 font-mono text-[8.5px] text-accent">⟨+@($"{E.AvailableLead:0.0}")s</span>
                            }
                            @if (E.Meta?.Handles is not null && E.AvailableTail > 0.05)
                            {
                                <span class="pointer-events-none absolute top-1/2 z-[5] -translate-y-1/2 rounded-[3px] bg-[rgba(20,19,18,0.85)] px-1 py-0.5 font-mono text-[8.5px] text-accent" style="left:calc(@Px(E.OutputDuration) + 2px)">+@($"{E.AvailableTail:0.0}")s⟩</span>
                            }
                        </div>
                    </div>

                    @* A1 voice *@
                    <div class="flex items-stretch border-b border-[#1A1918]" style="height:44px">
                        <div class="sticky left-0 z-[6] flex w-[118px] shrink-0 items-center gap-[7px] border-r border-[#1E1C1A] bg-panel px-[9px]">
                            <span class="w-5 font-mono text-[10px] font-medium text-soft">A1</span>
                            <span class="ml-auto font-mono text-[8.5px] text-ghost">VOICE · @($"{E.Doc.Audio.Voice * 100:0}%")</span>
                        </div>
                        <div class="relative" style="width:@($"{TotalWidth}px")">
                            @foreach (var (segment, outStart, outEnd) in E.SegmentLayout())
                            {
                                <div class="absolute bottom-[3px] top-[3px] overflow-hidden rounded-[3px] border border-[#3C5A3C] bg-[#1E2A1E]"
                                     style="left:@Px(outStart); width:@Px(outEnd - outStart)">
                                    <div class="absolute inset-x-[3px] inset-y-0.5 flex items-center gap-px opacity-80">
                                        @foreach (var bar in SampleData.Wave(Math.Clamp((int)((outEnd - outStart) * E.PxPerSec / 5), 8, 240), 0.35, 0.5, "#5E8A5E"))
                                        {
                                            <div class="flex-1 rounded-[1px]" style="height:@bar.H; background:@bar.C"></div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @* A2 music bed *@
                    <div class="flex items-stretch border-b border-[#1A1918]" style="height:36px">
                        <div class="sticky left-0 z-[6] flex w-[118px] shrink-0 items-center gap-[7px] border-r border-[#1E1C1A] bg-panel px-[9px]">
                            <span class="w-5 font-mono text-[10px] font-medium text-soft">A2</span>
                            <span class="ml-auto font-mono text-[8.5px] text-ghost">MUSIC · @(E.Doc.Audio.Music > 0.001 ? $"{E.Doc.Audio.Music * 100:0}%" : "off")</span>
                        </div>
                        <div class="relative" style="width:@($"{TotalWidth}px")">
                            @if (E.Doc.Audio.Music > 0.001)
                            {
                                <div class="absolute bottom-[3px] top-[3px] overflow-hidden rounded-[3px] border border-[#4A4171] bg-[#252038]"
                                     style="left:0; width:@Px(E.OutputDuration)">
                                    <div class="absolute left-1.5 top-0.5 text-[9px] font-semibold text-[#9C90C9]">ambient bed</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* playhead (over the scrolling area; offset by the header column) *@
            <div class="pointer-events-none absolute bottom-0 top-0 z-[8] w-[1.5px] bg-playhead" style="left:@($"{118 + E.PlayheadOutput * E.PxPerSec}px")">
                <div class="absolute -left-[4.5px] top-0 h-0 w-0 border-l-[5px] border-r-[5px] border-t-[6px] border-l-transparent border-r-transparent border-t-playhead"></div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly (string Key, string Icon, string Label)[] ToolDefs =
    [
        ("select", "⇱", "Select (click blocks)"),
        ("razor", "✂", "Razor — click a segment to split it"),
        ("trim", "⇹", "Trim — drag a segment's edges"),
        ("slip", "⇆", "Slip — drag inside a segment to shift its source window"),
        ("text", "T", "Text — click the timeline to add an overlay"),
        ("marker", "▽", "Marker — click to drop a marker"),
    ];

    private ElementReference _scroller;
    private EditorSession E => S.Edit;
    private double TotalWidth => Math.Max(100, E.OutputDuration * E.PxPerSec);
    private string Px(double seconds) => $"{seconds * E.PxPerSec:0.##}px";

    private string SegmentCursor => S.Tool switch
    {
        "razor" => "cursor-crosshair",
        "slip" => "cursor-grab",
        _ => "cursor-pointer",
    };

    // ---- ruler ----

    private record Mark(double X, string Label);

    private IEnumerable<Mark> RulerMarks()
    {
        double[] steps = [0.25, 0.5, 1, 2, 5, 10, 15, 30, 60, 120, 300];
        var step = steps.FirstOrDefault(s => s * E.PxPerSec >= 70, 300);
        var duration = E.OutputDuration;
        if (!double.IsFinite(duration)) yield break;
        // Long cut + max zoom would otherwise emit thousands of tick divs.
        if (duration / step > 500) step = duration / 500;
        for (var t = 0.0; t <= duration; t += step)
            yield return new Mark(t * E.PxPerSec, Fmt.Stamp(t));
    }

    // ---- clicks ----

    private void OnRulerClick(MouseEventArgs e) =>
        E.RequestSeek(E.OutputToSource(Math.Max(0, e.OffsetX / E.PxPerSec)));

    private void OnLaneClick(MouseEventArgs e)
    {
        var outputT = Math.Clamp(e.OffsetX / E.PxPerSec, 0, Math.Max(0, E.OutputDuration - 0.05));
        var sourceT = E.Snap(E.OutputToSource(outputT), S.Snap);
        switch (S.Tool)
        {
            case "text": E.AddText(sourceT); break;
            case "marker": E.AddMarker(sourceT); break;
            default: E.RequestSeek(sourceT); break;
        }
    }

    private void OnSegmentClick(MouseEventArgs e, EdlSegment segment, double outStart)
    {
        var sourceT = segment.SrcStart + (e.OffsetX / E.PxPerSec) * segment.Speed;
        switch (S.Tool)
        {
            case "razor":
                E.SplitAt(E.Snap(sourceT, S.Snap));
                break;
            case "text":
                E.AddText(E.Snap(sourceT, S.Snap));
                break;
            case "marker":
                E.AddMarker(E.Snap(sourceT, S.Snap));
                break;
            default:
                E.Select(segment.Id);
                E.RequestSeek(sourceT);
                break;
        }
    }

    private void OnBlockClick(string id)
    {
        if (S.Tool is "select" or "trim" or "slip") E.Select(id);
    }

    // ---- drags (trim edges, slip, move caption/text windows) ----

    private string? _dragId;
    private string _dragMode = "";
    private double _dragStartX;
    private double _lastAppliedDelta;
    private EdlSegment? _dragOriginal;
    private bool _dragDidApply;

    private void OnSegmentPointerDown(PointerEventArgs e, EdlSegment segment)
    {
        if (S.Tool == "slip")
            BeginDrag(e, segment.Id, "slip", segment);
        else if (S.Tool == "trim")
            BeginDrag(e, segment.Id, "trim-right", segment); // edges have their own handles
    }

    private void OnBlockPointerDown(PointerEventArgs e, string id, string mode)
    {
        if (S.Tool is "razor" or "text" or "marker") return;
        var segment = E.Doc?.Segments.FirstOrDefault(s => s.Id == id);
        BeginDrag(e, id, mode, segment);
    }

    private void BeginDrag(PointerEventArgs e, string id, string mode, EdlSegment? original)
    {
        _dragId = id;
        _dragMode = mode;
        _dragStartX = e.ClientX;
        _lastAppliedDelta = 0;
        _dragOriginal = original;
        _dragDidApply = false;
        E.Select(id);
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (_dragId is null || E.Doc is null) return;
        var outputDelta = (e.ClientX - _dragStartX) / E.PxPerSec;
        if (Math.Abs(outputDelta - _lastAppliedDelta) < 0.05) return;
        _lastAppliedDelta = outputDelta;

        // One undo entry per gesture: undo the interim state before reapplying.
        if (_dragDidApply) E.Undo();
        _dragDidApply = true;

        var speed = _dragOriginal?.Speed ?? 1.0;
        var sourceDelta = outputDelta * speed;
        switch (_dragMode)
        {
            case "trim-left" when _dragOriginal is { } left:
                E.TrimSegment(_dragId, leftEdge: true,
                    E.Snap(left.SrcStart + sourceDelta, S.Snap));
                break;
            case "trim-right" when _dragOriginal is { } right:
                E.TrimSegment(_dragId, leftEdge: false,
                    E.Snap(right.SrcEnd + sourceDelta, S.Snap));
                break;
            case "slip" when _dragOriginal is not null:
                E.SlipSegment(_dragId, E.Snap(sourceDelta, S.Snap));
                break;
            case "window":
                // Relative move; the collapse-undo above restored the gesture's
                // starting doc, so the full delta applies from the original.
                E.MoveWindow(_dragId, E.Snap(sourceDelta, S.Snap));
                break;
        }
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        _dragId = null;
        _dragOriginal = null;
    }

    // ---- visible windows ----

    private IEnumerable<(EdlCaption Caption, (double Start, double End) Window)> VisibleCaptions()
    {
        foreach (var caption in E.Doc!.Captions)
            if (E.MapWindow(caption.Start, caption.End) is { } window)
                yield return (caption, window);
    }

    private IEnumerable<(EdlText Text, (double Start, double End) Window)> VisibleTexts()
    {
        foreach (var text in E.Doc!.Texts)
            if (E.MapWindow(text.Start, text.End) is { } window)
                yield return (text, window);
    }
}
