@inherits StudioComponent
@inject IJSRuntime JS
@implements IAsyncDisposable

@* EDL-aware program monitor: plays the clean source while studio.js skips cut
   regions and applies per-segment speed; scale/pan preview via CSS transform;
   captions and text overlays render live from the document at the playhead. *@

<div class="anim-fade-up flex min-w-0 flex-1 flex-col bg-[#0D0C0B]" style="animation-delay:90ms">
    <div class="flex min-h-0 flex-1 items-center justify-center p-[18px] [container-type:size]">
        <div class="relative @AspectClasses overflow-hidden border border-line bg-[repeating-linear-gradient(-45deg,#191817_0_12px,#1D1B19_12px_24px)]">
            @if (MediaUrl is { } mediaUrl)
            {
                <video @ref="_video" @key="mediaUrl" src="@mediaUrl" poster="@S.ActivePosterUrl"
                       playsinline preload="metadata"
                       class="absolute inset-0 h-full w-full bg-black object-contain"
                       style="@TransformStyle"
                       @onclick="S.TogglePlay"
                       @onplay="() => S.SetPlaying(true)"
                       @onpause="() => S.SetPlaying(false)"
                       @onended="() => S.SetPlaying(false)"></video>
            }
            else
            {
                <div class="absolute inset-0 flex items-center justify-center">
                    <span class="flex items-center gap-2 font-mono text-[10px] text-dim">
                        <span class="h-1.5 w-1.5 animate-pulse-dc rounded-full bg-accent"></span>
                        rendering — program · @FormatLabel
                    </span>
                </div>
            }

            @* live EDL text overlays *@
            @foreach (var text in ActiveTexts)
            {
                <div class="pointer-events-none absolute left-[5%] right-[5%] z-10 text-center" style="top:@($"{text.Y * 100:0.#}%")">
                    <span class="text-[13px] font-extrabold uppercase leading-[1.2] text-fg [text-shadow:0_1px_3px_#141312,0_0_10px_#141312]">@text.Text</span>
                </div>
            }

            @* live EDL caption at the playhead *@
            @if (ActiveCaption is { } caption)
            {
                <div class="pointer-events-none absolute bottom-[12%] left-[8%] right-[8%] z-10 text-center">
                    @if (Style == "boxed")
                    {
                        <span class="rounded-[3px] bg-ink px-[7px] py-[3px] text-[15px] font-extrabold leading-[1.55] text-fg [box-decoration-break:clone] [-webkit-box-decoration-break:clone]">@caption.Text</span>
                    }
                    @if (Style == "plain")
                    {
                        <span class="text-[15px] font-extrabold leading-[1.55] text-fg [text-shadow:0_1px_3px_#141312,0_0_12px_#141312]">@caption.Text</span>
                    }
                    @if (Style == "karaoke")
                    {
                        <span class="text-[15px] font-extrabold leading-[1.55] text-muted [text-shadow:0_1px_3px_#141312]">
                            @foreach (var word in caption.Words ?? [])
                            {
                                <span class="@(word.S <= E.Playhead ? "text-accent" : "")">@word.T </span>
                            }
                            @if (caption.Words is null or { Count: 0 })
                            {
                                @caption.Text
                            }
                        </span>
                    }
                </div>
            }
        </div>
    </div>
    <div class="flex min-w-0 items-center gap-2.5 px-3.5 pb-3 pt-2">
        <span class="min-w-0 shrink overflow-hidden font-mono text-[13px] tracking-[0.03em] text-accent">@Fmt.Timecode(E.Doc is null ? _playhead : E.PlayheadOutput, E.Fps)</span>
        <div class="flex min-w-0 flex-1 items-center justify-center gap-2.5">
            <span title="Mark in — trim the segment start to here (I)" @onclick="E.MarkIn" class="cursor-pointer font-mono text-[11px] text-faint hover:text-accent">⟦</span>
            <span title="Previous edit point (↑)" @onclick="() => E.JumpEdit(-1)" class="cursor-pointer text-[13px] text-muted hover:text-fg">⏮</span>
            <span title="Back 5 seconds (PgUp / Alt+←)" @onclick="() => E.StepOutput(-5)" class="cursor-pointer font-mono text-[10.5px] text-muted hover:text-fg">«5</span>
            <span title="Back one frame (←)" @onclick="() => SeekBy(-E.FrameStep)" class="cursor-pointer text-[13px] text-muted hover:text-fg">◀</span>
            <span @onclick="TogglePlayButton" class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-fg text-xs text-ink hover:bg-white active:scale-90 @(MediaUrl is null ? "pointer-events-none opacity-40" : "")">@S.PlayIcon</span>
            @if (E.ShuttleRate is not 1)
            {
                <span class="rounded-[3px] border border-line2 px-1.5 py-0.5 font-mono text-[10px] text-accent">@(E.ShuttleRate < 0 ? $"◂×{Math.Abs(E.ShuttleRate):0.#}" : $"×{E.ShuttleRate:0.#}")</span>
            }
            <span title="Forward one frame (→)" @onclick="() => SeekBy(E.FrameStep)" class="cursor-pointer text-[13px] text-muted hover:text-fg">▶</span>
            <span title="Forward 5 seconds (PgDn / Alt+→)" @onclick="() => E.StepOutput(5)" class="cursor-pointer font-mono text-[10.5px] text-muted hover:text-fg">5»</span>
            <span title="Next edit point (↓)" @onclick="() => E.JumpEdit(1)" class="cursor-pointer text-[13px] text-muted hover:text-fg">⏭</span>
            <span title="Mark out — trim the segment end to here (O)" @onclick="E.MarkOut" class="cursor-pointer font-mono text-[11px] text-faint hover:text-accent">⟧</span>
        </div>
        <div class="flex min-w-0 shrink items-center justify-end gap-2 overflow-hidden">
            <div class="flex h-4 shrink-0 items-end gap-0.5">
                <div class="h-full w-[3px] bg-[linear-gradient(to_top,#5E6E33_0_62%,#D9F24B_62%_78%,#242220_78%)]"></div>
                <div class="h-full w-[3px] bg-[linear-gradient(to_top,#5E6E33_0_48%,#D9F24B_48%_60%,#242220_60%)]"></div>
            </div>
            <span class="whitespace-nowrap font-mono text-[11px] text-faint">@Fmt.Timecode(E.Doc is null ? _duration : E.OutputDuration, E.Fps)</span>
        </div>
    </div>
</div>

@code {
    private ElementReference _video;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ProgramMonitor>? _self;
    private bool _wasPlaying;
    private string? _watchedUrl;
    private string? _watchedSegments;
    private double _playhead;
    private double _duration;

    private EditorSession E => S.Edit;
    private string? MediaUrl => E.PreviewOverrideUrl ?? E.Meta?.SourceUrl ?? S.ActiveMediaUrl;
    private string Style => E.Doc?.CaptionStyle ?? S.CapStyle;

    string AspectClasses => S.ActiveClip is null
        ? "aspect-video w-[min(100%,177.7cqh)]"
        : S.ClipFormat switch
        {
            "square" => "aspect-square h-[min(100%,100cqw)]",
            "wide" => "aspect-video w-[min(100%,177.7cqh)]",
            _ => "aspect-[9/16] h-[min(100%,177.7cqw)]",
        };

    string FormatLabel => S.ActiveClip is null ? "16:9" : S.ClipFormat switch
    {
        "square" => "1:1",
        "wide" => "16:9",
        _ => "9:16",
    };

    // Manual-reframe preview: scale about a horizontal origin that matches the
    // renderer's crop window.
    private string TransformStyle
    {
        get
        {
            if (E.Doc is not { Reframe: "manual" } doc || doc.Transform.Scale <= 1.001) return "";
            var origin = Math.Clamp(0.5 + doc.Transform.PosX / 2.0, 0, 1) * 100;
            return $"transform:scale({doc.Transform.Scale:0.###});transform-origin:{origin:0.#}% 50%";
        }
    }

    private EdlCaption? ActiveCaption => E.Doc?.Captions
        .FirstOrDefault(c => E.Playhead >= c.Start && E.Playhead <= c.End);

    private IEnumerable<EdlText> ActiveTexts => E.Doc?.Texts
        .Where(t => E.Playhead >= t.Start && E.Playhead <= t.End) ?? [];

    private bool _disposed;
    private double _lastVolume = -1;
    private double _lastShuttle = 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (MediaUrl is null || _disposed) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/studio.js");
            _self ??= DotNetObjectReference.Create(this);
            if (_disposed) return; // closed while the module import was in flight

            var segmentsJson = SegmentsJson();
            if (_watchedUrl != MediaUrl || _watchedSegments != segmentsJson)
            {
                _watchedUrl = MediaUrl;
                _watchedSegments = segmentsJson;
                await _module.InvokeVoidAsync("watch", _video, _self, SegmentsPayload());
                _duration = await _module.InvokeAsync<double>("getDuration", _video);
                _lastShuttle = 1; // watch() rebuilt the JS state
            }
            if (_duration <= 0)
                _duration = await _module.InvokeAsync<double>("getDuration", _video);

            if (E.ConsumeSeek() is { } seek)
                await _module.InvokeVoidAsync("seek", _video, seek);

            var volume = E.Doc?.Audio.Voice ?? 1.0;
            if (Math.Abs(volume - _lastVolume) > 0.001)
            {
                _lastVolume = volume;
                await _module.InvokeVoidAsync("setVolume", _video, volume);
            }

            if (S.Playing != _wasPlaying)
            {
                _wasPlaying = S.Playing;
                await _module.InvokeVoidAsync("setPlaying", _video, S.Playing);
            }

            // After the play-state sync, so a reverse shuttle's scrub timer is
            // installed on the (now paused) element rather than cleared by it.
            if (Math.Abs(E.ShuttleRate - _lastShuttle) > 0.001)
            {
                _lastShuttle = E.ShuttleRate;
                await _module.InvokeVoidAsync("setShuttle", _video, E.ShuttleRate);
            }
        }
        catch (Exception exception) when (exception
            is JSDisconnectedException or JSException
            or ObjectDisposedException or InvalidOperationException
            or TaskCanceledException)
        {
            // Closing the editor mid-load races these interop calls; none of
            // them may tear the circuit down.
        }
    }

    private string SegmentsJson() => E.Doc is null
        ? "[]"
        : string.Join(";", E.Doc.Segments.Select(s => $"{s.SrcStart:0.###}-{s.SrcEnd:0.###}@{s.Speed:0.##}"));

    private object[] SegmentsPayload() => E.Doc is null
        ? []
        : E.Doc.Segments.Select(s => (object)new { start = s.SrcStart, end = s.SrcEnd, speed = s.Speed }).ToArray();

    [JSInvokable]
    public async Task OnPlayhead(double seconds)
    {
        _playhead = seconds;
        E.SetPlayhead(seconds);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SeekBy(double delta)
    {
        if (MediaUrl is null) return;
        if (E.Doc is not null)
        {
            // Step in OUTPUT time: stepping raw source time across a cut lands in
            // a removed region and the playback loop bounces the playhead away.
            E.StepOutput(delta);
            return;
        }
        if (_module is null) return;
        try
        {
            var now = await _module.InvokeAsync<double>("getCurrentTime", _video);
            await _module.InvokeVoidAsync("seek", _video, now + delta);
            _playhead = Math.Max(0, now + delta);
            E.SetPlayhead(_playhead);
        }
        catch (Exception exception) when (exception
            is JSDisconnectedException or JSException or ObjectDisposedException)
        {
        }
    }

    private void TogglePlayButton()
    {
        // A manual play/pause always leaves shuttle mode.
        if (E.ShuttleRate is not 1) E.SetShuttleRate(1);
        S.TogglePlay();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Dispose(); // StudioComponent's Changed unsubscribe
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("unwatch", _video);
                await _module.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception
            is JSDisconnectedException or JSException or ObjectDisposedException)
        {
        }
        _self?.Dispose();
    }
}
