@inherits StudioComponent
@inject IJSRuntime JS
@implements IAsyncDisposable

@* EDL-aware program monitor: plays the clean source while studio.js skips cut
   regions and applies per-segment speed; the delivery format and manual
   zoom/pan compose the frame the way the export does; captions are painted
   client-side (studio.js) so the karaoke sweep tracks the real playhead. *@

<div class="anim-fade-up flex min-w-0 flex-1 flex-col bg-[#0D0C0B]" style="animation-delay:90ms">
    <div class="flex min-h-0 flex-1 items-center justify-center p-[18px] [container-type:size]">
        <div class="relative @AspectClasses overflow-hidden border border-line bg-[repeating-linear-gradient(-45deg,#191817_0_12px,#1D1B19_12px_24px)]">
            @if (MediaUrl is { } mediaUrl)
            {
                @if (BlurPad && S.ActivePosterUrl is { } posterUrl)
                {
                    @* Stand-in for the export's blurred margins. A second synced
                       <video> would be exact and far more machinery. *@
                    <img src="@posterUrl" alt="" aria-hidden="true"
                         class="absolute inset-0 h-full w-full scale-110 object-cover blur-xl brightness-[0.55]" />
                }
                <video @ref="_video" @key="mediaUrl" src="@mediaUrl" poster="@S.ActivePosterUrl"
                       playsinline preload="metadata"
                       class="absolute inset-0 h-full w-full @(BlurPad ? "" : "bg-black") @VideoFit"
                       style="@TransformStyle"
                       @onclick="S.TogglePlay"
                       @onplay="() => S.SetPlaying(true)"
                       @onpause="() => S.SetPlaying(false)"
                       @onended="() => S.SetPlaying(false)"></video>
            }
            else
            {
                <div class="absolute inset-0 flex items-center justify-center">
                    <span class="flex items-center gap-2 font-mono text-[10px] text-dim">
                        <span class="h-1.5 w-1.5 animate-pulse-dc rounded-full bg-accent"></span>
                        rendering — program · @FormatLabel
                    </span>
                </div>
            }

            @* Overlay stage. Its own size container, so captions can be sized in
               cqh against the frame the way the export sizes them against the
               delivered height. *@
            <div class="pointer-events-none absolute inset-0 z-10 [container-type:size]">
                @foreach (var text in ActiveTexts)
                {
                    @* Not uppercased: the export burns the text as typed. *@
                    <div class="absolute left-[5%] right-[5%] text-center" style="top:@($"{text.Y * 100:0.#}%")">
                        <span class="text-[13px] font-extrabold leading-[1.2] text-fg [text-shadow:0_1px_3px_#141312,0_0_10px_#141312]">@text.Text</span>
                    </div>
                }
                <div @ref="_captionLayer" class="absolute bottom-[12%] left-[8%] right-[8%] text-center"></div>
            </div>
        </div>
    </div>
    <div class="flex min-w-0 items-center gap-2.5 px-3.5 pb-3 pt-2">
        <span class="min-w-0 shrink overflow-hidden font-mono text-[13px] tracking-[0.03em] text-accent">@Fmt.Timecode(E.Doc is null ? _playhead : E.PlayheadOutput, E.Fps)</span>
        @* Frame steps and 5-second skips only. The old ⏮/⏭ jumped to the
           previous/next edit point, which read as "back to the start". *@
        <div class="flex min-w-0 flex-1 items-center justify-center gap-2.5">
            <span data-tip="Mark in" @onclick="E.MarkIn" class="tip cursor-pointer font-mono text-[11px] text-faint hover:text-accent">⟦</span>
            <span data-tip="Back 5s" @onclick="() => E.StepOutput(-5)" class="tip cursor-pointer text-[13px] text-muted hover:text-fg">⏮</span>
            <span data-tip="Back 1 frame" @onclick="() => SeekBy(-E.FrameStep)" class="tip cursor-pointer text-[13px] text-muted hover:text-fg">◀</span>
            <span data-tip="@(S.Playing ? "Pause" : "Play")" @onclick="TogglePlayButton" class="tip flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-fg text-xs text-ink hover:bg-white active:scale-90 @(MediaUrl is null ? "pointer-events-none opacity-40" : "")">@S.PlayIcon</span>
            @if (E.ShuttleRate is not 1)
            {
                <span class="rounded-[3px] border border-line2 px-1.5 py-0.5 font-mono text-[10px] text-accent">@(E.ShuttleRate < 0 ? $"◂×{Math.Abs(E.ShuttleRate):0.#}" : $"×{E.ShuttleRate:0.#}")</span>
            }
            <span data-tip="Forward 1 frame" @onclick="() => SeekBy(E.FrameStep)" class="tip cursor-pointer text-[13px] text-muted hover:text-fg">▶</span>
            <span data-tip="Forward 5s" @onclick="() => E.StepOutput(5)" class="tip cursor-pointer text-[13px] text-muted hover:text-fg">⏭</span>
            <span data-tip="Mark out" @onclick="E.MarkOut" class="tip cursor-pointer font-mono text-[11px] text-faint hover:text-accent">⟧</span>
        </div>
        @* No level meter: the two bars that used to sit here were a fixed CSS
           gradient that never moved with the audio. *@
        <div class="flex min-w-0 shrink items-center justify-end gap-2 overflow-hidden">
            <span class="whitespace-nowrap font-mono text-[11px] text-faint">@Fmt.Timecode(E.Doc is null ? _duration : E.OutputDuration, E.Fps)</span>
        </div>
    </div>
</div>

@code {
    private ElementReference _video;
    private ElementReference _captionLayer;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ProgramMonitor>? _self;
    private bool _wasPlaying;
    private string? _watchedUrl;
    private string? _watchedSegments;
    private double _playhead;
    private double _duration;

    private EditorSession E => S.Edit;
    private string? MediaUrl => E.PreviewOverrideUrl ?? E.Meta?.SourceUrl ?? S.ActiveMediaUrl;
    private string Style => E.Doc?.CaptionStyle ?? S.CapStyle;

    private string Format => E.Doc?.Format ?? "source";
    private bool Targeted => Format is "vertical" or "square" or "wide";
    private bool Manual => E.Doc?.Reframe == "manual";

    /// <summary>Auto reframe into a delivery format letterboxes the frame over a
    /// blurred fill — the same composition the renderer builds.</summary>
    private bool BlurPad => Targeted && !Manual;

    /// <summary>Manual reframe crops to the target box (object-cover); every
    /// other case shows the whole frame.</summary>
    private string VideoFit => Targeted && Manual ? "object-cover" : "object-contain";

    string AspectClasses => Format switch
    {
        "vertical" => "aspect-[9/16] h-[min(100%,177.7cqw)]",
        "square" => "aspect-square h-[min(100%,100cqw)]",
        "wide" => "aspect-video w-[min(100%,177.7cqh)]",
        // "source": whatever the media itself is. Long-form cuts and
        // master-backed clips (the ones with handle material) are 16:9.
        _ => S.ActiveClip is null || E.Meta?.Handles is not null
            ? "aspect-video w-[min(100%,177.7cqh)]"
            : "aspect-[9/16] h-[min(100%,177.7cqw)]",
    };

    string FormatLabel => Format switch
    {
        "vertical" => "9:16",
        "square" => "1:1",
        "wide" => "16:9",
        _ => "source",
    };

    /// <summary>Mirrors the renderer's framing: pan slides the crop window
    /// horizontally (works at 1× against a target aspect, because object-cover
    /// is already cropping), zoom scales about the same origin.</summary>
    private string TransformStyle
    {
        get
        {
            if (E.Doc is not { } doc) return "";
            var origin = Math.Clamp(0.5 + doc.Transform.PosX / 2.0, 0, 1) * 100;
            var zoomed = doc.Transform.Scale > 1.001
                ? $"transform:scale({doc.Transform.Scale:0.###});transform-origin:{origin:0.#}% 50%"
                : "";
            if (Targeted && Manual)
            {
                var pan = $"object-position:{origin:0.#}% 50%";
                return zoomed.Length > 0 ? $"{pan};{zoomed}" : pan;
            }
            return Manual ? zoomed : "";
        }
    }

    private IEnumerable<EdlText> ActiveTexts => E.Doc?.Texts
        .Where(t => E.Playhead >= t.Start && E.Playhead <= t.End) ?? [];

    private bool _disposed;
    private double _lastVolume = -1;
    private double _lastShuttle = 1;
    private double _lastMusic = -1;
    private int _pushedCaptionRevision = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (MediaUrl is null || _disposed) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/studio.js");
            _self ??= DotNetObjectReference.Create(this);
            if (_disposed) return; // closed while the module import was in flight

            var segmentsJson = SegmentsJson();
            if (_watchedUrl != MediaUrl || _watchedSegments != segmentsJson)
            {
                var rewatched = _watchedUrl != MediaUrl;
                _watchedUrl = MediaUrl;
                _watchedSegments = segmentsJson;
                await _module.InvokeVoidAsync("watch", _video, _self, SegmentsPayload());
                _duration = await _module.InvokeAsync<double>("getDuration", _video);
                _lastShuttle = 1; // watch() rebuilt the JS state
                // A new media URL means a new <video> element, and the caption
                // engine keys its state off the element.
                if (rewatched) { _pushedCaptionRevision = -1; _lastMusic = -1; }
            }
            if (_duration <= 0)
                _duration = await _module.InvokeAsync<double>("getDuration", _video);

            if (E.ConsumeSeek() is { } seek)
                await _module.InvokeVoidAsync("seek", _video, seek);

            if (_pushedCaptionRevision != E.DocRevision)
            {
                _pushedCaptionRevision = E.DocRevision;
                await _module.InvokeVoidAsync("setCaptions", _video, _captionLayer,
                    CaptionsPayload(), Style, E.Doc?.CaptionsEnabled ?? true);
            }

            var volume = E.Doc?.Audio.Voice ?? 1.0;
            if (Math.Abs(volume - _lastVolume) > 0.001)
            {
                _lastVolume = volume;
                await _module.InvokeVoidAsync("setVolume", _video, volume);
            }

            var music = E.Doc?.Audio.Music ?? 0;
            if (Math.Abs(music - _lastMusic) > 0.001)
            {
                _lastMusic = music;
                await _module.InvokeVoidAsync("setMusicBed", _video, music);
            }

            if (S.Playing != _wasPlaying)
            {
                _wasPlaying = S.Playing;
                await _module.InvokeVoidAsync("setPlaying", _video, S.Playing);
            }

            // After the play-state sync, so a reverse shuttle's scrub timer is
            // installed on the (now paused) element rather than cleared by it.
            if (Math.Abs(E.ShuttleRate - _lastShuttle) > 0.001)
            {
                _lastShuttle = E.ShuttleRate;
                await _module.InvokeVoidAsync("setShuttle", _video, E.ShuttleRate);
            }
        }
        catch (Exception exception) when (exception
            is JSDisconnectedException or JSException
            or ObjectDisposedException or InvalidOperationException
            or TaskCanceledException)
        {
            // Closing the editor mid-load races these interop calls; none of
            // them may tear the circuit down.
        }
    }

    private string SegmentsJson() => E.Doc is null
        ? "[]"
        : string.Join(";", E.Doc.Segments.Select(s => $"{s.SrcStart:0.###}-{s.SrcEnd:0.###}@{s.Speed:0.##}"));

    private object[] SegmentsPayload() => E.Doc is null
        ? []
        : E.Doc.Segments.Select(s => (object)new { start = s.SrcStart, end = s.SrcEnd, speed = s.Speed }).ToArray();

    /// <summary>Caption lines for the client-side painter. Times are SOURCE
    /// seconds — the same clock the &lt;video&gt; reports.</summary>
    private object[] CaptionsPayload() => E.Doc is null
        ? []
        : E.Doc.Captions.Select(c => (object)new
        {
            id = c.Id,
            start = c.Start,
            end = c.End,
            text = c.Text,
            words = c.Words?.Select(w => new { t = w.T, s = w.S, e = w.E }).ToArray(),
        }).ToArray();

    [JSInvokable]
    public async Task OnPlayhead(double seconds)
    {
        _playhead = seconds;
        E.SetPlayhead(seconds);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SeekBy(double delta)
    {
        if (MediaUrl is null) return;
        if (E.Doc is not null)
        {
            // Step in OUTPUT time: stepping raw source time across a cut lands in
            // a removed region and the playback loop bounces the playhead away.
            E.StepOutput(delta);
            return;
        }
        if (_module is null) return;
        try
        {
            var now = await _module.InvokeAsync<double>("getCurrentTime", _video);
            await _module.InvokeVoidAsync("seek", _video, now + delta);
            _playhead = Math.Max(0, now + delta);
            E.SetPlayhead(_playhead);
        }
        catch (Exception exception) when (exception
            is JSDisconnectedException or JSException or ObjectDisposedException)
        {
        }
    }

    private void TogglePlayButton()
    {
        // A manual play/pause always leaves shuttle mode.
        if (E.ShuttleRate is not 1) E.SetShuttleRate(1);
        S.TogglePlay();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Dispose(); // StudioComponent's Changed unsubscribe
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("unwatch", _video);
                await _module.DisposeAsync();
            }
        }
        catch (Exception exception) when (exception
            is JSDisconnectedException or JSException or ObjectDisposedException)
        {
        }
        _self?.Dispose();
    }
}
