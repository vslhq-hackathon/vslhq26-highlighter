@* Theme-styled slider: the visual rail/fill/thumb matches the studio design;
   an invisible native range input on top does the actual work. *@

<div class="pb-4">
    <div class="mb-[7px] flex justify-between text-xs">
        <span class="font-semibold text-soft">@Label</span>
        <span class="font-mono text-[11px] text-muted">@Display</span>
    </div>
    <div class="relative h-[14px]">
        <div class="absolute inset-x-0 top-[5.5px] h-[3px] rounded-[2px] bg-well">
            <div class="absolute bottom-0 left-0 top-0 rounded-[2px] bg-accent" style="width:@($"{Percent:0.#}%")"></div>
        </div>
        <div class="pointer-events-none absolute top-[1.5px] h-[11px] w-[11px] -translate-x-[5px] rounded-full bg-fg" style="left:@($"{Percent:0.#}%")"></div>
        <input type="range" min="@Min" max="@Max" step="@Step" value="@Value"
               @oninput="OnInput"
               class="absolute inset-0 w-full cursor-pointer opacity-0" />
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Display { get; set; } = "";
    [Parameter] public double Value { get; set; }
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 1;
    [Parameter] public double Step { get; set; } = 0.01;
    [Parameter] public EventCallback<double> OnChange { get; set; }

    private double Percent => Max <= Min ? 0 : Math.Clamp((Value - Min) / (Max - Min) * 100, 0, 100);

    private async Task OnInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(),
            System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            await OnChange.InvokeAsync(value);
        }
    }
}
