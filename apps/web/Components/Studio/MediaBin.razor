@inherits StudioComponent

<div class="anim-fade-up flex min-h-0 w-[252px] shrink-0 flex-col border-r border-line bg-panel" style="animation-delay:60ms">
    <div class="flex gap-0.5 border-b border-line px-2.5 py-2">
        @foreach (var (key, label) in new[] { ("media", "Media"), ("caps", "Captions") })
        {
            <div @onclick="() => S.SetBinTab(key)" class="flex-1 cursor-pointer rounded py-[5px] text-center text-xs font-semibold hover:text-fg @(S.BinTab == key ? "bg-well text-fg" : "bg-transparent text-muted")">@label</div>
        }
    </div>

    @if (S.BinTab == "media")
    {
        <div class="anim-fade-up flex-1 overflow-y-auto p-2">
            <div class="px-1.5 pb-1 pt-1.5 font-mono text-[9.5px] tracking-[0.1em] text-faint">EDITING</div>
            @foreach (var item in MediaItems.Where(m => m.Section == "edit"))
            {
                <BinRow Item="item" Active="@(ActiveUrl == item.Url)" OnPick="Pick" />
            }
            <div class="px-1.5 pb-1 pt-3 font-mono text-[9.5px] tracking-[0.1em] text-faint">RENDERS</div>
            @if (!MediaItems.Any(m => m.Section == "render"))
            {
                <div class="px-1.5 py-1 text-[10.5px] leading-[1.5] text-faint">Other renders of this media appear here.</div>
            }
            @foreach (var item in MediaItems.Where(m => m.Section == "render"))
            {
                <BinRow Item="item" Active="@(ActiveUrl == item.Url)" OnPick="Pick" />
            }
        </div>
    }

    @if (S.BinTab == "caps")
    {
        <div class="anim-fade-up flex-1 overflow-y-auto p-1.5">
            @if (S.Edit.Doc is null or { Captions.Count: 0 })
            {
                <div class="px-2 py-2 text-[11px] leading-[1.5] text-faint">
                    No caption lines on this cut — the transcript had no words in its window.
                </div>
            }
            else
            {
                @foreach (var caption in S.Edit.Doc.Captions)
                {
                    var isActive = S.Edit.Playhead >= caption.Start && S.Edit.Playhead <= caption.End;
                    var isSelected = S.Edit.SelectedId == caption.Id;
                    <div class="flex gap-2 rounded-[5px] px-[9px] py-[6px] hover:bg-elevate @(isActive || isSelected ? "bg-well" : "bg-transparent")">
                        <span @onclick="() => Seek(caption)" class="shrink-0 cursor-pointer pt-[5px] font-mono text-[10px] @(isActive ? "text-accent" : "text-faint")">@Fmt.Stamp(caption.Start)</span>
                        <input value="@caption.Text"
                               @onfocus="() => S.Edit.Select(caption.Id)"
                               @onchange='e => S.Edit.UpdateCaptionText(caption.Id, e.Value?.ToString() ?? "")'
                               class="w-full border-none bg-transparent py-0.5 font-sans text-xs leading-[1.5] outline-none @(isActive || isSelected ? "text-fg" : "text-[#A8A399]")" />
                    </div>
                }
            }
        </div>
        @* Caption styling lives in the inspector with the rest of the
           document-level settings; this tab edits the lines themselves. *@
    }
</div>

@code {
    public record MediaItem(string Section, string Name, string Meta, string? Url, string? Thumb);

    private string? ActiveUrl => S.Edit.PreviewOverrideUrl ?? S.Edit.Meta?.SourceUrl ?? S.ActiveMediaUrl;

    private List<MediaItem> MediaItems
    {
        get
        {
            var items = new List<MediaItem>();
            if (S.ActiveClip is { } clip)
            {
                if (clip.VerticalUrl is { } vertical)
                    items.Add(new("edit", "Vertical 9:16", $"{Fmt.Duration(clip.DurationSeconds)} · clean", vertical, clip.ThumbnailUrl));
                if (clip.VideoUrl is { } source)
                    items.Add(new(items.Count == 0 ? "edit" : "render", "Source 16:9", Fmt.Duration(clip.DurationSeconds), source, clip.ThumbnailUrl));
                if (clip.CaptionedUrl is { } captioned)
                    items.Add(new("render", "Captioned 9:16", "pipeline captions", captioned, clip.ThumbnailUrl));
                if (S.Edit.Meta?.Export?.Url is { } exported)
                    items.Add(new("render", "Editor export", Fmt.Duration(S.Edit.Meta.Export.DurationSeconds), exported, S.Edit.Meta.Export.ThumbnailUrl));
            }
            else if (S.ActiveLongform is { } cut)
            {
                if (cut.VideoUrl is not null)
                    items.Add(new("edit", $"Long-form v{cut.Version}", Fmt.Duration(cut.DurationSeconds), cut.VideoUrl, cut.ThumbnailUrl));
                foreach (var other in (S.Detail?.LongformEdits ?? []).Where(e => e.Id != cut.Id && e.VideoUrl is not null))
                    items.Add(new("render", $"Long-form v{other.Version}", Fmt.Duration(other.DurationSeconds), other.VideoUrl, other.ThumbnailUrl));
            }
            return items;
        }
    }

    private void Pick(MediaItem item)
    {
        // Previewing the edited source again clears the override.
        S.Edit.SetPreview(item.Url == S.Edit.Meta?.SourceUrl ? null : item.Url);
    }

    private void Seek(EdlCaption caption) => S.Edit.RequestSeek(caption.Start);
}
