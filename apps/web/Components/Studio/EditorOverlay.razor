@inherits StudioComponent
@implements IAsyncDisposable
@inject ApiClient Api
@inject IJSRuntime JS

<div class="anim-rise absolute inset-0 z-40 flex flex-col bg-[#111010]" data-screen-label="Editor">

    @* Editor chrome *@
    <div class="flex min-h-11 shrink-0 items-center gap-3 border-b border-line bg-bar px-3.5 py-1.5">
        <div @onclick="S.CloseEditor" title="Close" class="flex cursor-pointer items-center gap-[7px] rounded-[5px] px-[9px] py-[5px] text-[12.5px] text-muted hover:bg-elevate hover:text-fg">✕ <span>Close</span></div>
        <div class="h-4 w-px bg-line2"></div>
        <div class="min-w-0 break-words text-[13px] font-semibold leading-[1.3]">@Fmt.Title(S.ActiveClipTitle)</div>
        <div class="shrink-0 text-[11px] @(S.Edit.SaveState == "Save failed" ? "text-playhead" : "text-faint")">@S.ProjectTitle · @S.Edit.SaveState.ToLowerInvariant()</div>
        <div class="ml-auto flex items-center gap-2">
            <div class="flex overflow-hidden rounded-[5px] border border-line2">
                <div @onclick="S.Edit.Undo" data-tip="Undo" class="tip tip-below cursor-pointer px-[9px] py-1 text-[12.5px] leading-none hover:bg-elevate @(S.Edit.CanUndo ? "text-soft hover:text-fg" : "pointer-events-none text-ghost")">↺</div>
                <div @onclick="S.Edit.Redo" data-tip="Redo" class="tip tip-below cursor-pointer border-l border-line2 px-[9px] py-1 text-[12.5px] leading-none hover:bg-elevate @(S.Edit.CanRedo ? "text-soft hover:text-fg" : "pointer-events-none text-ghost")">↻</div>
            </div>
            <div class="rounded-[5px] border border-line2 px-2.5 py-[5px] font-mono text-[11.5px] text-muted">@FormatChip</div>
            @* Live while the cut differs from how it opened — autosave flipping
               SaveState to "Saved" used to grey this out seconds after an edit,
               which is what made the button look broken. *@
            <div @onclick="() => _ = S.Edit.FlushSaveAsync(commit: true)" title="Save"
                 class="cursor-pointer rounded-[5px] border border-line2 px-3 py-[5px] text-[12.5px] text-soft hover:border-[#4A4638] hover:text-fg active:scale-[0.98] @(SaveIdle ? "pointer-events-none opacity-60" : "")">
                @(S.Edit.SaveState == "Saving…" ? "Saving…" : SaveIdle ? "Saved ✓" : "Save")
            </div>
            <div @onclick="() => _ = S.Edit.ExportAsync()" title="Export"
                 class="flex cursor-pointer items-center gap-1.5 rounded-[5px] border border-line2 px-3 py-[5px] text-[12.5px] text-soft hover:border-[#4A4638] hover:text-fg active:scale-[0.98] @(S.Edit.ExportBusy ? "pointer-events-none opacity-60" : "")">
                @if (S.Edit.ExportBusy)
                {
                    <span class="h-1.5 w-1.5 animate-pulse-dc rounded-full bg-accent"></span>
                    <span>Exporting…</span>
                }
                else
                {
                    <span>Export</span>
                }
            </div>
            <span title="@(S.WorkerActionsAvailable ? null : "This project's run files aren't on this machine")">
                <div @onclick="() => S.OpenPublish(S.ActiveClip)" class="cursor-pointer rounded-[5px] bg-accent px-[13px] py-[5px] text-[12.5px] font-bold text-ink hover:bg-accent-soft active:scale-95 @(S.WorkerActionsAvailable ? "" : "pointer-events-none opacity-40")">Publish</div>
            </span>
        </div>
    </div>

    @if (S.Edit.ExportError is not null || S.Edit.ExportDone)
    {
        <div class="anim-drop-in flex shrink-0 items-center gap-3 border-b border-line px-3.5 py-2 text-[12px] @(S.Edit.ExportError is null ? "bg-[#1A2114] text-soft" : "bg-playhead/10 text-soft")">
            @if (S.Edit.ExportError is { } error)
            {
                <span class="min-w-0 flex-1 truncate">Export failed: @error</span>
            }
            else if (S.ActiveClip is null)
            {
                <span class="min-w-0 flex-1 truncate">Export finished — it's on the project page as a new version.</span>
            }
            else
            {
                <span class="min-w-0 flex-1 truncate">Export finished — it's in the media bin.</span>
                @if (S.Edit.ExportDoneUrl is { } url)
                {
                    <a href="@url" target="_blank" class="shrink-0 font-semibold text-accent hover:text-accent-soft">Open</a>
                }
            }
        </div>
    }

    @* Editor body *@
    <div class="flex min-h-0 flex-1">
        <MediaBin />
        <ProgramMonitor />
        <RightPanel />
    </div>

    <TimelinePanel />

    @if (S.CloseConfirmOpen)
    {
        <ConfirmModal Title="Save your changes?"
                      Detail="Discarding returns this cut to how it was when you opened the editor."
                      Error="@S.CloseError" Busy="S.CloseBusy"
                      ConfirmLabel="Save" BusyLabel="Saving…"
                      SecondaryLabel="Discard"
                      OnConfirm="() => S.ConfirmCloseAsync(true)"
                      OnSecondary="() => S.ConfirmCloseAsync(false)"
                      OnCancel="S.CancelClose" />
    }
</div>

@code {
    bool SaveIdle => !S.Edit.ChangedSinceOpen || S.Edit.SaveState == "Saving…";

    // The delivered size, straight off the document — the chip used to claim
    // 1080 × 1920 for exports that were actually the source's geometry.
    string FormatChip => S.Edit.Doc?.Format switch
    {
        "vertical" => "1080 × 1920",
        "square" => "1080 × 1080",
        "wide" => "1920 × 1080",
        _ => "source size",
    };

    // The overlay owns the editor's keyboard: one document-level JS listener
    // (bound while the overlay lives) so shortcuts work wherever focus sits,
    // with preventDefault decided synchronously client-side.
    private IJSObjectReference? _module;
    private DotNetObjectReference<EditorOverlay>? _self;
    private bool _bound;
    private bool _disposed;
    private bool? _guardDirty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/studio.js");
                if (_disposed) return;
                _self = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("bindEditorKeys", _self);
                _bound = true;
            }
            if (_module is null) return;
            // Autosave debounces 1.5s; a tab closed inside that window would
            // lose the edit without the browser's own confirmation prompt.
            var dirty = S.Edit.ChangedSinceOpen;
            if (_guardDirty != dirty)
            {
                _guardDirty = dirty;
                await _module.InvokeVoidAsync("setDirtyGuard", dirty);
            }
        }
        catch (Exception exception) when (exception
            is JSDisconnectedException or JSException
            or ObjectDisposedException or InvalidOperationException
            or TaskCanceledException)
        {
        }
    }

    public sealed record EditorKeyPayload(string Key, bool Shift, bool Alt, bool Mod);

    [JSInvokable]
    public Task OnEditorKey(EditorKeyPayload key)
    {
        var E = S.Edit;
        switch (key)
        {
            case { Key: " " }:
                if (E.ShuttleRate != 1) E.SetShuttleRate(1);
                S.TogglePlay();
                break;
            case { Key: "z" or "Z", Mod: true }:
                if (key.Shift) E.Redo(); else E.Undo();
                break;
            case { Key: "k" or "K", Mod: true }:
                E.SplitAt(E.Playhead);
                break;
            case { Key: "ArrowLeft" or "ArrowRight" }:
                var direction = key.Key == "ArrowRight" ? 1 : -1;
                var step = key.Alt ? 5.0 : key.Shift ? 1.0 : E.FrameStep;
                E.StepOutput(direction * step);
                break;
            case { Key: "ArrowUp" }: E.JumpEdit(-1); break;
            case { Key: "ArrowDown" }: E.JumpEdit(1); break;
            case { Key: "PageUp" }: E.StepOutput(-5); break;
            case { Key: "PageDown" }: E.StepOutput(5); break;
            case { Key: "Home" } when E.Doc is not null:
                E.RequestSeek(E.OutputToSource(0));
                break;
            case { Key: "End" } when E.Doc is not null:
                E.RequestSeek(E.OutputToSource(Math.Max(0, E.OutputDuration - E.FrameStep)));
                break;
            case { Key: "i" or "I" }: E.MarkIn(); break;
            case { Key: "o" or "O" }: E.MarkOut(); break;
            case { Key: "j" or "J" }: Shuttle(-1); break;
            case { Key: "k" or "K" }: Shuttle(0); break;
            case { Key: "l" or "L" }: Shuttle(1); break;
            case { Key: "Delete" or "Backspace" }: E.DeleteSelected(); break;
            case { Key: "+" or "=" }: E.Zoom(1.4); break;
            case { Key: "-" or "_" }: E.Zoom(1 / 1.4); break;
        }
        return Task.CompletedTask;
    }

    /// <summary>J/K/L: repeated presses escalate ×1 → ×2 → ×4 (forward or
    /// reverse); K stops playback and resets to ×1. The rate lands on
    /// EditorSession and the program monitor syncs it to the video.</summary>
    void Shuttle(int direction)
    {
        var E = S.Edit;
        if (direction == 0)
        {
            E.SetShuttleRate(1);
            S.SetPlaying(false);
        }
        else if (direction > 0)
        {
            var next = E.ShuttleRate >= 1 && S.Playing ? Math.Min(E.ShuttleRate * 2, 4) : 1;
            E.SetShuttleRate(next);
            S.SetPlaying(true);
        }
        else
        {
            var next = E.ShuttleRate < 0 ? Math.Max(E.ShuttleRate * 2, -4) : -1;
            S.SetPlaying(false);
            E.SetShuttleRate(next);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Dispose(); // StudioComponent's Changed unsubscribe
        try
        {
            if (_module is not null)
            {
                if (_bound) await _module.InvokeVoidAsync("unbindEditorKeys");
                await _module.InvokeVoidAsync("setDirtyGuard", false);
            }
        }
        catch (Exception exception) when (exception
            is JSDisconnectedException or JSException or ObjectDisposedException)
        {
        }
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _self?.Dispose();
    }
}
