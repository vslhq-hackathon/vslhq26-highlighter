# Copy to .env and fill in your own values. Never commit real secrets.

# Supabase (Postgres + Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Azure OpenAI (scoring, editing, agents, thumbnails)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EDIT_DEPLOYMENT=
AZURE_AUDIO_API_KEY=
AZURE_AUDIO_ENDPOINT=
AZURE_OPENAI_AUDIO_DEPLOYMENT=

# Azure AI Speech (transcription)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=

# Deepgram (transcription fallback)
DEEPGRAM_API_KEY=

# OpenRouter (LLM fallback)
OPENROUTER_API_KEY=

# upload-post.com (social publishing)
UPLOAD_POST_USER=
UPLOAD_POST_API_KEY=

# Pipeline concurrency (API-call parallelism, not CPU): how many LLM scoring
# calls and Azure Speech transcriptions run in flight. LLM calls go to
# OpenRouter first (Azure fallback) — raise until 429s or climbing per-call
# latency, then back off a decent step below (defaults: 8 / 2).
#LLM_CONCURRENCY=16
#TRANSCRIBE_CONCURRENCY=4

# Storage upload guard: Supabase rejects objects over the project's global cap
# (measured 52428800 = 50 MiB) with a 413. Renders over this guard are
# re-encoded to fit (short form) or served from the API's /media mirror
# (long form; HIGHLIGHTER_MEDIA_BASE overrides the mirror base URL).
# Default: 51380224 (49 MiB = cap - 1 MiB safety margin).
#HIGHLIGHTER_MAX_UPLOAD_BYTES=51380224

# Distributed ingest (Azure deployment only; unset locally). When the API runs
# with Pipeline__DistributedIngest=true, ingest jobs are queued here and picked
# up by highlighter-worker Container Apps Job executions.
#JOBS_QUEUE_CONNECTION=
#JOBS_QUEUE_NAME=pipeline-jobs
